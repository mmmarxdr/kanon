# Kanon DEV (single-box) environment template. Copy to `.env` and fill in:
#   cp env.template .env
# Generate each secret with: openssl rand -hex 32
# NEVER commit the real .env (see deploy/dev/.gitignore).

# ── Public URL ────────────────────────────────────────────────────────────
# sslip.io maps <ip>.sslip.io → that IP with zero DNS setup. Use your EC2
# Elastic IP with DOTS, e.g. 52.1.2.3.sslip.io. Caddy will obtain TLS for it.
# When you move to a real domain, change all four of these together.
SITE_ADDRESS=REPLACE_WITH_EIP.sslip.io
CORS_ORIGIN=https://REPLACE_WITH_EIP.sslip.io
APP_URL=https://REPLACE_WITH_EIP.sslip.io
BASE_URL=https://REPLACE_WITH_EIP.sslip.io

# ── Database (containerized Postgres) ─────────────────────────────────────
POSTGRES_USER=kanon
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
POSTGRES_DB=kanon
# DATABASE_URL host MUST be the compose service name `postgres`.
# The password here MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://kanon:REPLACE_DB_PASSWORD@postgres:5432/kanon?schema=public

# ── Auth secrets (required in production; JWT secrets must be ≥32 chars) ───
JWT_SECRET=REPLACE_32CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_32CHAR_SECRET
COOKIE_SECRET=REPLACE_32CHAR_SECRET

# ── Production-required secrets (validated at API boot — packages/api/src/config/env.ts) ──
# With NODE_ENV=production the API REFUSES to start unless BOTH are set.
# METRICS_TOKEN: bearer token for the GET /metrics scrape endpoint.
#   openssl rand -hex 32
# INTEGRATION_ENCRYPTION_KEY: base64-encoded 32-byte key (AES-256-GCM) that
#   encrypts per-user integration credentials at rest.
#   openssl rand -base64 32
METRICS_TOKEN=REPLACE_METRICS_TOKEN
INTEGRATION_ENCRYPTION_KEY=REPLACE_BASE64_32BYTE_KEY

# Optional exact origin/IP exception for an HTTP-only private Redmine endpoint.
# Every DNS answer must match one of the configured addresses; omit by default.
# REDMINE_ENDPOINT_ALLOWLIST={"http://redmine.internal.example":["10.20.30.40"]}

# ── Runtime ───────────────────────────────────────────────────────────────
# NODE_ENV=production so cookies are Secure and prod validations run — this is
# why we need real TLS (Caddy) even on the dev box.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ── Email ─────────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY blank to use the console provider (no real delivery —
# invite/verify/reset emails are logged, not sent). Set it to send for real.
RESEND_API_KEY=
EMAIL_FROM=Kanon <noreply@kanon.dev>

# ── Engram sync (optional; off by default) ────────────────────────────────
ENGRAM_SYNC_ENABLED=false
# ENGRAM_URL=http://engram:7437
# ENGRAM_API_KEY=
