# ── Database (required) ────────────────────────────────────────
DATABASE_URL="postgresql://kanon:kanon@localhost:5432/kanon?schema=public"

# ── Auth (required) ───────────────────────────────────────────
JWT_SECRET="dev-jwt-secret-change-in-production"        # Min 16 chars
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-in-production"  # Min 16 chars
COOKIE_SECRET=                    # Optional. Random string for cookie signing.

# ── Server ────────────────────────────────────────────────────
PORT=3000                         # Optional. Default: 3000
NODE_ENV=development              # Optional. development | production | test
CORS_ORIGIN=http://localhost:5173 # Optional. Comma-separated URLs
TRIAGE_SEARCH_ENABLED=false        # Enable bounded issue triage search
TRIAGE_PREVIEW_ENABLED=false       # Enable read-only issue triage preview
TRIAGE_PROPOSAL_READS_ENABLED=false # Enable triage proposal get/list recovery surfaces
TRIAGE_PROPOSALS_ENABLED=false     # Enable triage proposal persistence
TRIAGE_DISMISS_ENABLED=false       # Enable triage proposal dismissal
TRIAGE_RETENTION_ENABLED=false     # Enable expiry/retention workers last

# ── Engram (optional) ────────────────────────────────────────
