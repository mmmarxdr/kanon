model NotificationPreference {
  id               String  @id @default(uuid()) @db.Uuid
  memberId         String  @unique @map("member_id") @db.Uuid
  member           Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  emailMention     Boolean @default(true) @map("email_mention")
  emailAssignment  Boolean @default(true) @map("email_assignment")
  emailCycleClosed Boolean @default(true) @map("email_cycle_closed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ─── External PM Integrations (KAN-179 / ADR-0012) ───────────────────────────

// Workspace-level link to one external PM instance (Redmine first; Jira/MS later).
// statusMapRead/Write are per-connection config (no universal default — every
// workflow differs). discoveredStatuses caches {id,name} for the mapping UI.
model IntegrationConnection {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String // "redmine" | "jira" | "ms-project"
  baseUrl     String   @map("base_url")
  lifecycle              IntegrationLifecycle @default(draft)
  lifecycleEpoch         Int                  @default(0) @map("lifecycle_epoch")
  serviceFallbackEnabled Boolean              @default(false) @map("service_fallback_enabled")
  // Optional pointer to the workspace-owner credential used for discovery + as the
  // outbound write fallback. Plain column (no FK): the target row may be removed
  // independently and a dangling pointer is handled as "no service credential".
  serviceCredentialId String? @map("service_credential_id") @db.Uuid
  discoveredStatuses  Json?   @map("discovered_statuses")
  statusMapRead       Json?   @map("status_map_read")
  statusMapWrite      Json?   @map("status_map_write")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  credentials MemberIntegrationCredential[]
  externalRefs ExternalRef[]
  bindings IntegrationProjectBinding[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("integration_connections")
}

model IntegrationProjectBinding {
  id              String               @id @default(uuid()) @db.Uuid
  remoteProjectId String               @map("remote_project_id")
  readMap         Json                 @map("read_map")
  writeMap        Json                 @map("write_map")
  lifecycle       IntegrationLifecycle @default(draft)
  lifecycleEpoch  Int                  @default(0) @map("lifecycle_epoch")
  cursorUpdatedAt DateTime?            @map("cursor_updated_at")
  cursorRemoteId  String?              @map("cursor_remote_id")
  pageToken       String?              @map("page_token")
  pollLeaseToken  String?              @map("poll_lease_token")
  pollLeaseUntil  DateTime?            @map("poll_lease_until")
  pollFence       Int                  @default(0) @map("poll_fence")
  commentCaptureEnabled  Boolean       @default(false) @map("comment_capture_enabled")
  commentDispatchEnabled Boolean       @default(false) @map("comment_dispatch_enabled")
  inboundEnabled      Boolean                   @default(false) @map("inbound_enabled")
  bootstrapState      IntegrationBootstrapState @default(not_required) @map("bootstrap_state")
  bootstrapCutoff     DateTime?                 @map("bootstrap_cutoff")
  bootstrapPageToken  Json?                     @map("bootstrap_page_token")
  bootstrapLeaseToken String?                   @map("bootstrap_lease_token")
  bootstrapLeaseUntil DateTime?                 @map("bootstrap_lease_until")
  bootstrapFence      Int                       @default(0) @map("bootstrap_fence")
  auditCursorRemoteId String?                   @map("audit_cursor_remote_id")
  auditCompletedAt    DateTime?                 @map("audit_completed_at")
  releaseRequestedAt  DateTime?                 @map("release_requested_at")
  releasedAt          DateTime?                 @map("released_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  connectionId String                @map("connection_id") @db.Uuid
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  projectId    String                @map("project_id") @db.Uuid
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalRefs      ExternalRef[]
  externalIdentities IntegrationExternalIdentity[]
  works             IntegrationSyncWork[]
  applications      IntegrationInboundApplication[]
  conflicts         IntegrationConflict[]
  provenance        IntegrationContentProvenance[]
  auditRuns         IntegrationAuditRun[]
  reconciliationRecommendations IntegrationReconciliationRecommendation[]
  reconciliationDispositions    IntegrationReconciliationDisposition[]

  @@unique([connectionId, projectId])
  @@unique([connectionId, remoteProjectId])
  @@index([remoteProjectId, releasedAt])
  @@index([releaseRequestedAt])
  @@index([lifecycle, pollLeaseUntil])
  @@index([bootstrapState, bootstrapLeaseUntil])
  @@index([projectId])
  @@map("integration_project_bindings")
}

// Provider identity mapping is scoped to a project binding. Credentials remain
// authentication material only; this model maps a Kanon member to a remote user.
model IntegrationAuditRun {
  id                 String                   @id @default(uuid()) @db.Uuid
  scopeFingerprint   String                   @map("scope_fingerprint")
  leaseToken         String                   @map("lease_token")
  fence              Int
  state              IntegrationAuditRunState @default(partial)
  reasonCode         String?                  @map("reason_code")
  providerObservedAt DateTime?                @map("provider_observed_at")
  completedAt        DateTime?                @map("completed_at")
  validUntil         DateTime?                @map("valid_until")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  bindingId    String                    @map("binding_id") @db.Uuid
  binding      IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  checkpoint   IntegrationAuditCheckpoint?
  observations IntegrationAuditObservation[]

  @@index([bindingId, state, completedAt])
  @@index([bindingId, scopeFingerprint])
  @@map("integration_audit_runs")
}

model IntegrationAuditCheckpoint {
