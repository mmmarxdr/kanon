/// Instance-level admin invite (KAN-49 first-run-bootstrap PR1b).
/// Separate from workspace_invites — no nullable surgery on that table.
/// JWT scope="instance_onboard", sub=id. Single-use: consumedAt guards replay.
model InstanceAdminInvite {
  id          String    @id @default(uuid()) @db.Uuid
  /// Raw JWT token (also the kanon:// payload)
  token       String    @unique
  /// Recipient email (admin-controlled at creation time)
  email       String
  /// JWT sub claim — equals id; stored for fast lookup in consumeInstanceAdminInvite
  jwtSub      String    @unique @map("jwt_sub")
  /// Set when the invite is consumed; blocks replay
  consumedAt  DateTime? @map("consumed_at")
  /// Set when the invite is manually revoked
  revokedAt   DateTime? @map("revoked_at")
  /// Token expiry (JWT exp mirrors this; DB check is defense-in-depth)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([jwtSub])
  @@map("instance_admin_invites")
}

// ─── Capture & Notify Models (S1 / KAN-30) ──────────────────────────────────

model WorkLog {
  id        String        @id @default(uuid()) @db.Uuid
  startedAt DateTime      @map("started_at")
  endedAt   DateTime      @map("ended_at")
  durationS Int           @map("duration_s")
  reason    WorkLogReason @default(stopped)
  via       String?

  issueId  String @map("issue_id") @db.Uuid
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // PPM timesheet back-relation (KAN-100 PR3)
  timeEntry TimeEntry?

  @@index([issueId, endedAt(sort: Desc)])  // GET /issues/:key/worklogs
  @@index([memberId, endedAt(sort: Desc)]) // GET /me/worklogs
  @@map("work_logs")
}

/// KAN-103 (ADR-0005 D6) — the Interruption edge: what an incident displaced.
/// Written automatically when work switches to an incident while a session is
/// active (via "session_switch"), or recorded manually (via "manual"). Incident
/// hours themselves flow through the normal WorkLog→TimeEntry path; this row only
/// records the displacement so PPM/forecast can attribute the unplanned work.
model Interruption {
  id String @id @default(uuid()) @db.Uuid

  /// The incident issue that displaced the interrupted work.
  incidentIssueId String @map("incident_issue_id") @db.Uuid
  incidentIssue   Issue  @relation("IncidentInterruptions", fields: [incidentIssueId], references: [id], onDelete: Cascade)

  /// The issue whose work was displaced.
  interruptedIssueId String @map("interrupted_issue_id") @db.Uuid
  interruptedIssue   Issue  @relation("InterruptedWork", fields: [interruptedIssueId], references: [id], onDelete: Cascade)

  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  /// Capture mechanism — "session_switch" (auto) or "manual" (provenance, per KAN-100 §8 #7).
  via       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([incidentIssueId])
  @@index([interruptedIssueId])
  @@index([memberId, startedAt(sort: Desc)])
  @@map("interruptions")
}

/// KAN-100 PR3 — TimeEntry: records billable work against an issue.
/// Lifecycle: draft → submitted → approved / rejected.
/// Adjustments (negative hours) link back to an approved entry via adjustsId.
///
/// Invariants (ppm-engine §8):
///   #1  WorkLog is read-only from timesheet — no update path.
///   #2  Approved entries are immutable — amendments go via createAdjustment.
///   #3  Negative hours only when adjustsId IS NOT NULL (DB CHECK + service guard).
///   #7  via + human owner on every row and event.
model TimeEntry {
  id        String          @id @default(uuid()) @db.Uuid
  memberId  String          @map("member_id") @db.Uuid
  member    Member          @relation("TimeEntryMember", fields: [memberId], references: [id], onDelete: Restrict)
  issueId   String?         @map("issue_id") @db.Uuid
  /// Issue may be null for issue-less work (e.g. internal overhead).
  /// ON DELETE SET NULL: if the issue is deleted, the time entry is kept but unlinked.
  issue     Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  hours     Decimal         @db.Decimal(8, 2)
  workedOn  DateTime        @map("worked_on")
  status    TimeEntryStatus @default(draft)

  /// Idempotency: at most one TimeEntry per WorkLog source.
  /// We declare @unique here so Prisma can express the 1:1 WorkLog→TimeEntry relation.
  /// The migration SQL drops Prisma's full unique index and replaces it with a
  /// PARTIAL UNIQUE INDEX (WHERE source_work_log_id IS NOT NULL), ensuring NULLs
  /// (manual entries without a source WorkLog) can coexist freely.
  sourceWorkLogId String?  @unique @map("source_work_log_id") @db.Uuid
  sourceWorkLog   WorkLog? @relation(fields: [sourceWorkLogId], references: [id], onDelete: SetNull)

  /// Self-FK: adjustments point back to the original approved entry.
  adjustsId   String?    @map("adjusts_id") @db.Uuid
  adjusts     TimeEntry? @relation("TimeEntryAdjustments", fields: [adjustsId], references: [id], onDelete: SetNull)
  adjustments TimeEntry[] @relation("TimeEntryAdjustments")

  /// Rate snapshots: set to null in W1 (MemberRate model not yet landed).
  /// TODO(KAN-rate / PPM P1): copy MemberRate snapshots when the money model lands.
  costRateSnapshot Decimal? @map("cost_rate_snapshot") @db.Decimal(12, 2)
  billRateSnapshot Decimal? @map("bill_rate_snapshot") @db.Decimal(12, 2)

  via         String?  @map("via")
  approvedById String? @map("approved_by_id") @db.Uuid
  approvedBy  Member? @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt  DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId, workedOn])
  @@index([issueId, status])
  @@map("time_entries")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  kind        NotificationKind
  workspaceId String           @map("workspace_id") @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   Member           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?          @map("actor_id") @db.Uuid
  actor       Member?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issueId     String?          @map("issue_id") @db.Uuid
  issue       Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  mentionId   String?          @map("mention_id") @db.Uuid
  mention     Mention?         @relation(fields: [mentionId], references: [id], onDelete: SetNull) // D2
  commentId   String?          @map("comment_id") @db.Uuid
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)
  payload     Json?            // {issueKey,issueTitle,context,...} kind-specific
  read        Boolean          @default(false)
  via         String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, read, createdAt(sort: Desc)]) // unread count + inbox list
  @@index([issueId])    // cascade + per-issue lookups
  @@index([mentionId])  // SetNull sweep perf
  @@index([actorId])    // SetNull on member delete
  @@index([commentId])  // SetNull on comment delete
  @@map("notifications")
}

model IssueSubscription {
  id       String  @id @default(uuid()) @db.Uuid
  origin   String  @default("manual") // manual|creator|assignee|commenter
  optedOut Boolean @default(false) @map("opted_out") // true = explicit unsubscribe persisted

  issueId  String @map("issue_id") @db.Uuid
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([issueId, memberId]) // doubles as subscribers-per-issue index
  @@index([memberId])
  @@map("issue_subscriptions")
}

model NotificationPreference {
  id               String  @id @default(uuid()) @db.Uuid
  memberId         String  @unique @map("member_id") @db.Uuid
  member           Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  emailMention     Boolean @default(true) @map("email_mention")
  emailAssignment  Boolean @default(true) @map("email_assignment")
  emailCycleClosed Boolean @default(true) @map("email_cycle_closed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

// ─── External PM Integrations (KAN-179 / ADR-0012) ───────────────────────────

// Workspace-level link to one external PM instance (Redmine first; Jira/MS later).
// statusMapRead/Write are per-connection config (no universal default — every
// workflow differs). discoveredStatuses caches {id,name} for the mapping UI.
model IntegrationConnection {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String // "redmine" | "jira" | "ms-project"
  baseUrl     String   @map("base_url")
  // Optional pointer to the admin credential used for discovery + as the
  // outbound write fallback. Plain column (no FK): the target row may be removed
  // independently and a dangling pointer is handled as "no service credential".
  serviceCredentialId String? @map("service_credential_id") @db.Uuid
  discoveredStatuses  Json?   @map("discovered_statuses")
  statusMapRead       Json?   @map("status_map_read")
  statusMapWrite      Json?   @map("status_map_write")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  credentials MemberIntegrationCredential[]
  externalRefs ExternalRef[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("integration_connections")
}

// Per-user credential: each member supplies their own provider API key, stored
// encrypted-at-rest (AES-256-GCM, see core/crypto.ts). externalUserId binds the
// Kanon member to the provider user (resolved via /my/account.json on connect).
model MemberIntegrationCredential {
  id             String   @id @default(uuid()) @db.Uuid
  encryptedKey   String   @map("encrypted_key")
  externalUserId String?  @map("external_user_id")
  externalLogin  String?  @map("external_login")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberId     String                @map("member_id") @db.Uuid
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  connectionId String                @map("connection_id") @db.Uuid
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([memberId, connectionId])
  @@index([connectionId])
  @@map("member_integration_credentials")
}

// Idempotency / link backbone: maps a Kanon entity (polymorphic by entityType)
// to its external object. entityId is NOT a formal FK because it spans
// issue/project/cycle tables.
model ExternalRef {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") // "issue" | "project" | "cycle"
  // @db.Uuid: all referenceable Kanon entities (issue/project/cycle) use UUID PKs.
  entityId    String   @map("entity_id") @db.Uuid
  externalId  String   @map("external_id")
  externalUrl String?  @map("external_url")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  connectionId String                @map("connection_id") @db.Uuid
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entityType, entityId])
  // entityType is part of the external-id uniqueness: providers (e.g. Redmine)
  // use independent id sequences per type, so issue #42 and project #42 collide
  // on externalId alone.
  @@unique([connectionId, entityType, externalId])
  @@index([entityType, entityId])
  @@map("external_refs")
}
