  @@index([bindingId, laneKey, sequence])
  @@index([state, availableAt])
  @@map("integration_sync_work")
}

model IntegrationInboundApplication {
  id               String                  @id @default(uuid()) @db.Uuid
  remoteEntityType String                  @map("remote_entity_type")
  /// Empty strings represent parentless entities so composite unique indexes still deduplicate them.
  remoteParentType String                  @default("") @map("remote_parent_type")
  remoteParentId   String                  @default("") @map("remote_parent_id")
  remoteId         String                  @map("remote_id")
  remoteUpdatedAt  DateTime                @map("remote_updated_at")
  sourceVersion    String?                 @map("source_version")
  applicationKey   String                  @unique @map("application_key")
  correlationId    String                  @map("correlation_id")
  state            InboundApplicationState @default(claimed)
  leaseToken       String?                 @map("lease_token")
  leaseUntil       DateTime?               @map("lease_until")
  fence            Int                     @default(0)
  refId            String?                 @map("ref_id") @db.Uuid
  workId           String?                 @map("work_id") @db.Uuid
  outcome          Json?
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  binding          IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  bindingId        String                    @map("binding_id") @db.Uuid
  ref              ExternalRef?              @relation(fields: [refId], references: [id], onDelete: SetNull)
  work             IntegrationSyncWork?      @relation(fields: [workId], references: [id], onDelete: SetNull)
  conflicts        IntegrationConflict[]

  @@unique([bindingId, remoteEntityType, remoteParentType, remoteParentId, remoteId, sourceVersion], map: "uq_inbound_application_source")
  @@map("integration_inbound_applications")
}

/// Durable field-level origin evidence; unknown/conflicting origins remain explicit.
model IntegrationContentProvenance {
  id            String                   @id @default(uuid()) @db.Uuid
  entityType    String                   @map("entity_type")
  entityId      String                   @map("entity_id") @db.Uuid
  field         String
  origin        IntegrationContentOrigin @default(unknown)
  sourceVersion String?                  @map("source_version")
  contentHash   String?                  @map("content_hash")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  bindingId String                    @map("binding_id") @db.Uuid
  binding   IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([bindingId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@map("integration_content_provenance")
}

model IntegrationConflict {
  id             String          @id @default(uuid()) @db.Uuid
  kind           String
  state          ConflictState   @default(open)
  localEvidence  Json            @map("local_evidence")
  remoteEvidence Json            @map("remote_evidence")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  bindingId     String                       @map("binding_id") @db.Uuid
  binding       IntegrationProjectBinding    @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  workId        String?                      @map("work_id") @db.Uuid
  work          IntegrationSyncWork?         @relation(fields: [workId], references: [id], onDelete: SetNull)
  refId         String?                      @map("ref_id") @db.Uuid
  ref           ExternalRef?                 @relation(fields: [refId], references: [id], onDelete: SetNull)
