  run             IntegrationAuditRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, identityType, parentRemoteId, remoteId, sourceUpdatedAt])
  @@index([runId, observedAt])
  @@map("integration_audit_observations")
}

model IntegrationExternalIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  remoteUserId      String   @map("remote_user_id")
  remoteLogin       String?  @map("remote_login")
  remoteDisplayName String?  @map("remote_display_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  bindingId String                    @map("binding_id") @db.Uuid
  binding   IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  memberId  String?                   @map("member_id") @db.Uuid
  member    Member?                   @relation(fields: [memberId], references: [id], onDelete: SetNull)
