  entityType      String        @map("entity_type")
  entityId        String        @map("entity_id") @db.Uuid
  direction       SyncDirection
  operation       SyncOperation
  sequence        BigInt        @default(autoincrement()) @unique
  dedupeKey       String        @unique @map("dedupe_key")
  laneKey         String        @map("lane_key")
  actorKey        String        @map("actor_key")
  actorKind       ActorKind     @map("actor_kind")
  payload         Json
  correlationId   String        @map("correlation_id")
  state           SyncWorkState @default(queued)
  attempts        Int           @default(0)
  availableAt     DateTime      @default(now()) @map("available_at")
  leaseToken      String?       @map("lease_token")
  leaseUntil      DateTime?     @map("lease_until")
  fence           Int           @default(0)
  epoch           Int
  authCredentialId String?      @map("auth_credential_id") @db.Uuid
  refId           String?       @map("ref_id") @db.Uuid
  marker          String?
  skippedReason   String?       @map("skipped_reason")
  requestedStatus String?       @map("requested_status")
  actualStatus    String?       @map("actual_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  binding        IntegrationProjectBinding    @relation(fields: [bindingId], references: [id], onDelete: Cascade)
  bindingId      String                       @map("binding_id") @db.Uuid
  authCredential MemberIntegrationCredential? @relation(fields: [authCredentialId], references: [id], onDelete: SetNull)
  ref            ExternalRef?                @relation(fields: [refId], references: [id], onDelete: SetNull)
  applications   IntegrationInboundApplication[]
