model WorkLog {
  id        String        @id @default(uuid()) @db.Uuid
  startedAt DateTime      @map("started_at")
  endedAt   DateTime      @map("ended_at")
  durationS Int           @map("duration_s")
  reason    WorkLogReason @default(stopped)
  via       String?

  issueId  String @map("issue_id") @db.Uuid
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  // PPM timesheet back-relation (KAN-100 PR3)
  timeEntry TimeEntry?
  transitionLifecycle WorkTransitionLifecycle?

  @@index([issueId, endedAt(sort: Desc)])  // GET /issues/:key/worklogs
  @@index([memberId, endedAt(sort: Desc)]) // GET /me/worklogs
  @@map("work_logs")
}

/// KAN-103 (ADR-0005 D6) — the Interruption edge: what an incident displaced.
/// Written automatically when work switches to an incident while a session is
/// active (via "session_switch"), or recorded manually (via "manual"). Incident
/// hours themselves flow through the normal WorkLog→TimeEntry path; this row only
/// records the displacement so PPM/forecast can attribute the unplanned work.
model Interruption {
  id String @id @default(uuid()) @db.Uuid

  /// The incident issue that displaced the interrupted work.
  incidentIssueId String @map("incident_issue_id") @db.Uuid
  incidentIssue   Issue  @relation("IncidentInterruptions", fields: [incidentIssueId], references: [id], onDelete: Cascade)

  /// The issue whose work was displaced.
  interruptedIssueId String @map("interrupted_issue_id") @db.Uuid
  interruptedIssue   Issue  @relation("InterruptedWork", fields: [interruptedIssueId], references: [id], onDelete: Cascade)

  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  /// Capture mechanism — "session_switch" (auto) or "manual" (provenance, per KAN-100 §8 #7).
  via       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([incidentIssueId])
  @@index([interruptedIssueId])
  @@index([memberId, startedAt(sort: Desc)])
  @@map("interruptions")
}

/// KAN-100 PR3 — TimeEntry: records billable work against an issue.
/// Lifecycle: draft → submitted → approved / rejected.
/// Adjustments (negative hours) link back to an approved entry via adjustsId.
///
/// Invariants (ppm-engine §8):
///   #1  WorkLog is read-only from timesheet — no update path.
///   #2  Approved entries are immutable — amendments go via createAdjustment.
///   #3  Negative hours only when adjustsId IS NOT NULL (DB CHECK + service guard).
///   #7  via + human owner on every row and event.
model TimeEntry {
  id        String          @id @default(uuid()) @db.Uuid
  memberId  String          @map("member_id") @db.Uuid
  member    Member          @relation("TimeEntryMember", fields: [memberId], references: [id], onDelete: Restrict)
  issueId   String?         @map("issue_id") @db.Uuid
  /// Issue may be null for issue-less work (e.g. internal overhead).
  /// ON DELETE SET NULL: if the issue is deleted, the time entry is kept but unlinked.
  issue     Issue?          @relation(fields: [issueId], references: [id], onDelete: SetNull)
  hours     Decimal         @db.Decimal(8, 2)
  workedOn  DateTime        @map("worked_on")
  status    TimeEntryStatus @default(draft)

  /// Idempotency: at most one TimeEntry per WorkLog source.
  /// We declare @unique here so Prisma can express the 1:1 WorkLog→TimeEntry relation.
  /// The migration SQL drops Prisma's full unique index and replaces it with a
  /// PARTIAL UNIQUE INDEX (WHERE source_work_log_id IS NOT NULL), ensuring NULLs
  /// (manual entries without a source WorkLog) can coexist freely.
  sourceWorkLogId String?  @unique @map("source_work_log_id") @db.Uuid
  sourceWorkLog   WorkLog? @relation(fields: [sourceWorkLogId], references: [id], onDelete: SetNull)

  /// Self-FK: adjustments point back to the original approved entry.
  adjustsId   String?    @map("adjusts_id") @db.Uuid
  adjusts     TimeEntry? @relation("TimeEntryAdjustments", fields: [adjustsId], references: [id], onDelete: SetNull)
  adjustments TimeEntry[] @relation("TimeEntryAdjustments")

  /// Rate snapshots: set to null in W1 (MemberRate model not yet landed).
  /// TODO(KAN-rate / PPM P1): copy MemberRate snapshots when the money model lands.
  costRateSnapshot Decimal? @map("cost_rate_snapshot") @db.Decimal(12, 2)
  billRateSnapshot Decimal? @map("bill_rate_snapshot") @db.Decimal(12, 2)

  via         String?  @map("via")
  approvedById String? @map("approved_by_id") @db.Uuid
  approvedBy  Member? @relation("TimeEntryApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt  DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([memberId, workedOn])
  @@index([issueId, status])
  @@map("time_entries")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  kind        NotificationKind
  workspaceId String           @map("workspace_id") @db.Uuid
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipientId String           @map("recipient_id") @db.Uuid
  recipient   Member           @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?          @map("actor_id") @db.Uuid
  actor       Member?          @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issueId     String?          @map("issue_id") @db.Uuid
  issue       Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  mentionId   String?          @map("mention_id") @db.Uuid
