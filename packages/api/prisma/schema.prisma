  workCaptureFailureEpisodeId String? @unique @map("work_capture_failure_episode_id") @db.Uuid
  payload     Json?            // {issueKey,issueTitle,context,...} kind-specific
  read        Boolean          @default(false)
  via         String?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([recipientId, read, createdAt(sort: Desc)]) // unread count + inbox list
  @@index([issueId])    // cascade + per-issue lookups
  @@index([mentionId])  // SetNull sweep perf
  @@index([actorId])    // SetNull on member delete
  @@index([commentId])  // SetNull on comment delete
  @@map("notifications")
}

model IssueSubscription {
