  /// Stored-only placeholder for layer 2 enforcement (NOT enforced in foundation).
  allowedSignupDomains String[] @default([]) @map("allowed_signup_domains")

  ownerUserId String? @unique @map("owner_user_id") @db.Uuid
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

