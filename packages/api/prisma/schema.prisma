generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum IssueType {
  feature
  bug
  task
  spike
  incident
}

enum IssuePriority {
  critical
  high
  medium
  low
}

enum IssueState {
  backlog
  analysis
  todo
  in_progress
  review
  done
}

enum MemberRole {
  owner
  admin
  pm
  member
  viewer
}

enum CycleState {
  upcoming
  active
  done
}

enum CycleScopeEventKind {
  add
  remove
}

enum ActivityAction {
  created
  state_changed
  assigned
  commented
  cycle_changed
  edited
  engram_synced
  document_added
  baseline_set
}

enum DocumentKind {
  adr
  pdr
  rfc
  note
}

enum CommentSource {
  human
  mcp
  engram_sync
  system
  adr
}

enum Horizon {
  now
  next
  later
  someday
}

enum RoadmapStatus {
  idea
  planned
  in_progress
  done
}

enum DependencyType {
  blocks
}

enum InviteKind {
  MEMBER
  ONBOARDING
}

enum NotificationKind {
  mention
  assignment
  subscribed_activity
  cycle_closed
}

enum WorkLogReason {
  stopped
  expired
}

enum RefreshSource {
  ONBOARDING
  LOGIN
}

/// KAN-100 PR3: TimeEntry approval state machine.
/// draft → submitted → approved / rejected
/// Adjustments (negative-hours corrections) re-enter at draft.
enum TimeEntryStatus {
  draft
  submitted
  approved
  rejected
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  /// @deprecated X-API-Key auth removed in PR1 (KAN-35). Column kept nullable for
  /// restorative revert — drop in a later migration once PR1 is stable on prod.
  apiKeyHash      String?   @map("api_key_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  /// Instance-level admin flag (KAN-49 first-run-bootstrap PR1a).
  /// Granted by claimInstance() and grantInstanceAdmin(). Orthogonal to
  /// ownerUserId (super-admin) and per-workspace MemberRole.
  isInstanceAdmin Boolean   @default(false) @map("is_instance_admin")
  /// Super-admin flag (KAN-49 first-run-bootstrap MEDIUM-1).
  /// Set atomically alongside ownerUserId in claimInstance(). Allows /me to
  /// derive isSuperAdmin from a single user-row read instead of a JOIN on
  /// InstanceSettings. Default false — existing rows are unaffected.
  isSuperAdmin    Boolean   @default(false) @map("is_super_admin")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  members                  Member[]
  workSessions             WorkSession[]
  createdInvites           WorkspaceInvite[]
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  projectMembers           ProjectMember[]
  emailVerificationTokens  EmailVerificationToken[]
  magicLinkTokens          MagicLinkToken[]
  instanceOwnership        InstanceSettings?
  createdInstanceInvites   InstanceAdminInvite[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  allowedDomains String[] @default([]) @map("allowed_domains")

  projects       Project[]
  members        Member[]
  invites        WorkspaceInvite[]
  proposals      McpProposal[]
  refreshTokens  RefreshToken[]
  mentions       Mention[]
  notifications  Notification[]
  // External PM integrations (KAN-179 / ADR-0012)
  integrationConnections IntegrationConnection[]

  @@map("workspaces")
}

model McpProposal {
  id          String            @id @default(uuid()) @db.Uuid
  kind        McpProposalKind
  status      McpProposalStatus @default(pending)
  title       String
  reason      String?
  /** Optional reference key — issue key, roadmap item id, etc. */
  targetRef   String?           @map("target_ref")
  /** Free-form payload (action description, suggested values). */
  payload     Json?
  /** Identifier of the agent that produced the proposal (e.g. "claude-mcp"). */
  generatedBy String?           @map("generated_by")
  proposedAt  DateTime          @default(now()) @map("proposed_at")
  appliedAt   DateTime?         @map("applied_at")
  dismissedAt DateTime?         @map("dismissed_at")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([projectId, status])
  // KAN-116: a partial UNIQUE index `mcp_proposals_pending_generic_target_ref_key`
  // on (workspace_id, target_ref) WHERE status='pending' AND kind='generic' enforces
  // at most one pending generic proposal per targetRef PER WORKSPACE (multi-instance
  // dedup backstop; tenant-local since target_ref/issue keys are per-workspace).
  // Partial indexes aren't expressible in Prisma schema — see the migration.
  @@map("mcp_proposals")
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(6)
  name        String
  description String?
  archived         Boolean  @default(false)
  engramNamespace  String?  @map("engram_namespace")
  /// Last assigned sequence number. Incremented atomically on each issue create (KAN-53).
  lastSequenceNum  Int      @default(0) @map("last_sequence_num")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  issues         Issue[]
  cycles         Cycle[]
  roadmapItems   RoadmapItem[]
  proposals      McpProposal[]
  projectMembers ProjectMember[]
  milestones     Milestone[]
  // PPM working-day calendar (KAN-147, ADR-0007)
  scheduleConfig ProjectScheduleConfig?

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("projects")
}

/// KAN-147 (ADR-0007): per-project working-day calendar consumed by the forecast
/// engine. 1:1 with Project (mirrors IssueSchedule↔Issue). Absent config means
/// Mon–Fri + no holidays, so existing projects need zero backfill.
model ProjectScheduleConfig {
  projectId String   @id @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// UTC weekday indices that are working days (0=Sun..6=Sat). Default Mon–Fri.
  workDays  Int[]    @default([1, 2, 3, 4, 5]) @map("work_days")
  /// ISO YYYY-MM-DD (UTC) dates that are holidays (non-working) for this project.
  holidays  String[] @default([]) @map("holidays")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_schedule_configs")
}

model Issue {
  id          String        @id @default(uuid()) @db.Uuid
  key         String        @unique
  sequenceNum Int           @map("sequence_num")
  title       String
  description String?
  type        IssueType     @default(task)
  priority    IssuePriority @default(medium)
  state       IssueState    @default(backlog)
  labels      String[]      @default([])
  /// Set to the transition timestamp when the issue moves to `done`; cleared to NULL on reopen. KAN-35.
  completedAt      DateTime?  @map("completed_at")
  /// KAN-157: stamped by reconcileIssueTime() when the dev confirms captured hours before →done.
  /// Considered STALE if any WorkLog or TimeEntry for the issue was created after this timestamp.
  timeConfirmedAt  DateTime?  @map("time_confirmed_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  // Grouping key for SDD change aggregation (derived from topic_key prefix)
  groupKey    String?       @map("group_key")

  // JSON fields for extensibility
  engramContext Json? @map("engram_context")
  specArtifacts Json? @map("spec_artifacts")

  // Relations
  projectId  String  @map("project_id") @db.Uuid
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   Member? @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  /** Story-point estimate. Null = unestimated. Used by Cycles burnup. */
  estimate Int? @map("estimate")

  cycleId String? @map("cycle_id") @db.Uuid
  cycle   Cycle?  @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  parentId String? @map("parent_id") @db.Uuid
  parent   Issue?  @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("SubIssues")

  roadmapItemId String?      @map("roadmap_item_id") @db.Uuid
  roadmapItem   RoadmapItem? @relation(fields: [roadmapItemId], references: [id], onDelete: SetNull)

  activityLogs      ActivityLog[]
  comments          Comment[]
  workSessions      WorkSession[]
  workLogs          WorkLog[]
  mentions          Mention[]
  documents         IssueDocument[]
  notifications     Notification[]
  subscriptions     IssueSubscription[]

  // Issue→Issue dependencies (semantically distinct from RoadmapDependency)
  blocks    IssueDependency[] @relation("IssueBlocks")
  blockedBy IssueDependency[] @relation("IssueBlockedBy")

  // PPM schedule (KAN-99 PR2a)
  schedule          IssueSchedule?
  estimateRevisions EstimateRevision[]
  // PPM timesheet (KAN-100 PR3)
  timeEntries       TimeEntry[]
  // PPM milestones (KAN-101 PR2)
  milestoneDeliverables MilestoneDeliverable[]
  // PPM forecast (KAN-102 PR1)
  forecast              IssueForecast?
  // PPM incidents (KAN-103 PR1)
  interruptionsCaused   Interruption[] @relation("IncidentInterruptions")
  interruptionsSuffered Interruption[] @relation("InterruptedWork")

  @@unique([projectId, key])
  @@unique([projectId, sequenceNum])
  @@index([projectId, state])
  @@index([projectId, groupKey])
  @@index([cycleId])
  @@index([assigneeId])
  @@index([parentId])
  @@map("issues")
}

enum IssueDependencyType {
  blocks
  FS
  SS
  FF
  SF
}

/// KAN-101 PR2: Milestone lifecycle states.
/// upcoming → at_risk (management signal) → met (manually via PATCH) | missed
enum MilestoneStatus {
  upcoming
  at_risk
  met
  missed
}

// ─── PPM Schedule Models (KAN-99 PR2a) ───────────────────────────────────────

/// 1:1 with Issue. Mutable plan plane: startDate, dueDate, progress, estimateHours.
/// estimateHours is ONLY ever written inside reviseEstimate (Invariant #9).
/// baseline* columns reserved for cycle-activation snapshot (future slice).
model IssueSchedule {
  issueId       String    @id @db.Uuid
  issue         Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  startDate     DateTime? @map("start_date")
  dueDate       DateTime? @map("due_date")
  progress      Int       @default(0)                             // 0-100
  estimateHours Decimal?  @map("estimate_hours") @db.Decimal(8, 2)
  baselineStart DateTime? @map("baseline_start")
  baselineEnd   DateTime? @map("baseline_end")
  baselineSetAt DateTime? @map("baseline_set_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("issue_schedules")
}

/// Append-only audit log of estimate changes (Invariant #9).
/// No updatedAt — createdAt only, matching WorkLog/ActivityLog pattern.
model EstimateRevision {
  id       String  @id @default(uuid()) @db.Uuid
  issueId  String  @map("issue_id") @db.Uuid
  issue    Issue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  hours    Decimal @db.Decimal(8, 2)
  reason   String?
  authorId String  @map("author_id") @db.Uuid
  author   Member  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  via      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([issueId, createdAt])
  @@map("estimate_revisions")
}

enum McpProposalKind {
  promote_roadmap_item    // Promote a roadmap item to a sooner horizon
  add_dependency          // Suggest a new dependency edge (issue or roadmap)
  split_issue             // Split a single issue into atomic sub-issues
  reassign                // Suggest a different assignee
  generic                 // Anything else; payload describes
}

enum McpProposalStatus {
  pending
  applied
  dismissed
}

model IssueDependency {
  id        String              @id @default(uuid()) @db.Uuid
  type      IssueDependencyType @default(blocks)
  lagDays   Int                 @default(0) @map("lag_days")
  createdAt DateTime            @default(now()) @map("created_at")

  sourceId String @map("source_id") @db.Uuid
  source   Issue  @relation("IssueBlocks", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String @map("target_id") @db.Uuid
  target   Issue  @relation("IssueBlockedBy", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@map("issue_dependencies")
}

// ─── PPM Milestones (KAN-101 PR2) ────────────────────────────────────────────

/// Project-level planning milestone. Owns a set of MilestoneDeliverable edges.
/// ownerId defaults to the creating actor at the service layer.
/// metOn is SET MANUALLY via PATCH (v1 — no auto-stamp on status→met).
model Milestone {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  target    DateTime
  status    MilestoneStatus @default(upcoming)
  metOn     DateTime?       @map("met_on")
  createdAt DateTime        @default(now()) @map("created_at")

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ownerId String @map("owner_id") @db.Uuid
  owner   Member @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  deliverables MilestoneDeliverable[]

  @@index([projectId])
  @@map("milestones")
}

/// Join table: Milestone M:N Issue.
/// @@unique([milestoneId, issueId]) prevents duplicate attachments.
/// Issue MUST belong to the milestone's project (enforced at service layer).
model MilestoneDeliverable {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  milestoneId String    @map("milestone_id") @db.Uuid
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  issueId String @map("issue_id") @db.Uuid
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, issueId])
  @@index([issueId])
  @@map("milestone_deliverables")
}

// ─── PPM Forecast (KAN-102 PR1) ──────────────────────────────────────────────

/// L2 derived forecast plane. One row per Issue. Engine writes it; rebuilt
/// fully per debounced event. inputsHash is used to skip no-op writes.
model IssueForecast {
  issueId       String    @id @db.Uuid
  issue         Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  forecastStart DateTime? @map("forecast_start")
  forecastEnd   DateTime? @map("forecast_end")
  slipDays      Int       @default(0) @map("slip_days")
  critical      Boolean   @default(false)
  floatDays     Int?      @map("float_days")
  /// Hash of the COMPUTED forecast output {forecastStart,forecastEnd,slipDays,critical,floatDays},
  /// NOT of the issue's inputs. The skip-write gate must catch propagated slip from upstream
  /// predecessors (a successor's forecast changes while its own inputs don't), so it keys on
  /// output. Column name kept for back-compat (no migration). See KAN-102 PR2.
  inputsHash    String?   @map("inputs_hash")
  computedAt    DateTime  @map("computed_at")

  @@index([critical])
  @@map("issue_forecasts")
}

model Cycle {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  goal      String?
  state     CycleState @default(upcoming)
  startDate DateTime   @map("start_date")
  endDate   DateTime   @map("end_date")
  /** Velocity in story points. Set when the cycle is closed. */
  velocity  Int?
  /// Set to the close timestamp when closeCycle runs. NULL for historical cycles closed before KAN-35. KAN-35.
  closedAt  DateTime?  @map("closed_at")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues      Issue[]
  scopeEvents CycleScopeEvent[]

  @@index([projectId, state])
  @@index([projectId, startDate])
  @@map("cycles")
}

model CycleScopeEvent {
  id        String              @id @default(uuid()) @db.Uuid
  /** Day index within the cycle (1-based) at the moment of the change. */
  day       Int
  kind      CycleScopeEventKind
  /** Issue key (KAN-123) at the time of the event. Stored as string so the
   *  event survives even if the issue is later deleted. */
  issueKey  String              @map("issue_key")
  reason    String?
  createdAt DateTime            @default(now()) @map("created_at")

  cycleId String @map("cycle_id") @db.Uuid
  cycle   Cycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  authorId String? @map("author_id") @db.Uuid
  author   Member? @relation("CycleScopeAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([cycleId, day])
  @@map("cycle_scope_events")
}

model Member {
  id        String     @id @default(uuid()) @db.Uuid
  username  String
  role      MemberRole @default(member)
  isAgent   Boolean    @default(false) @map("is_agent")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  assignedIssues              Issue[]            @relation("AssignedIssues")
  activityLogs                ActivityLog[]
  comments                    Comment[]
  documents                   IssueDocument[]
  workSessions                WorkSession[]
  workLogs                    WorkLog[]
  cycleScopeEvents            CycleScopeEvent[]  @relation("CycleScopeAuthor")
  adminAuditLogs              AdminAuditLog[]
  mentionsReceived            Mention[]          @relation("MentionedMember")
  mentionsSent                Mention[]          @relation("MentionedByMember")
  notificationsReceived       Notification[]     @relation("NotificationRecipient")
  notificationsAsActor        Notification[]     @relation("NotificationActor")
  issueSubscriptions          IssueSubscription[]
  notificationPreference      NotificationPreference?
  // PPM relations (KAN-99 PR2a)
  estimateRevisions           EstimateRevision[]
  // PPM timesheet (KAN-100 PR3)
  timeEntries                 TimeEntry[]        @relation("TimeEntryMember")
  approvedTimeEntries         TimeEntry[]        @relation("TimeEntryApprover")
  // PPM milestones (KAN-101 PR2)
  ownedMilestones             Milestone[]
  // PPM incidents (KAN-103 PR1)
  interruptions               Interruption[]
  // External PM integrations (KAN-179 / ADR-0012)
  integrationCredentials      MemberIntegrationCredential[]

  @@unique([userId, workspaceId])
  @@unique([workspaceId, username])
  @@map("members")
}

model ActivityLog {
  id        String         @id @default(uuid()) @db.Uuid
  action    ActivityAction
  details   Json?
  via       String?
  createdAt DateTime       @default(now()) @map("created_at")

  issueId String @map("issue_id") @db.Uuid
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("activity_logs")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  body      String
  source    CommentSource @default(human)
  via       String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  issueId String @map("issue_id") @db.Uuid
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  mentions      Mention[]
  notifications Notification[]

  @@index([issueId, createdAt])
  @@map("comments")
}

model IssueDocument {
  id        String       @id @default(uuid()) @db.Uuid
  kind      DocumentKind @default(note)
  title     String       @db.VarChar(200)
  body      String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  issueId String @map("issue_id") @db.Uuid
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  authorId String @map("author_id") @db.Uuid
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("issue_documents")
}

model Mention {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  issueId             String   @map("issue_id") @db.Uuid
  commentId           String?  @map("comment_id") @db.Uuid       // null = mention en Issue.description
  mentionedMemberId   String   @map("mentioned_member_id") @db.Uuid
  mentionedByMemberId String   @map("mentioned_by_member_id") @db.Uuid
  context             String   @db.Text                          // fragmento con la @mention
  read                Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")

  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issue             Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  comment           Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedMember   Member         @relation("MentionedMember",   fields: [mentionedMemberId],   references: [id], onDelete: Cascade)
  mentionedByMember Member         @relation("MentionedByMember", fields: [mentionedByMemberId], references: [id], onDelete: Cascade)
  notifications     Notification[]

  @@unique([commentId, mentionedMemberId], map: "uniq_mention_per_comment_member")
  @@index([workspaceId, mentionedMemberId, read, createdAt(sort: Desc)], map: "idx_mention_dashboard_query")
  @@index([issueId])
  @@index([commentId])
  @@map("mentions")
}

model RoadmapItem {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  horizon     Horizon  @default(later)
  effort      Int?
  impact      Int?
  labels      String[] @default([])
  targetDate  DateTime? @map("target_date")
  sortOrder   Float         @default(0) @map("sort_order")
  promoted    Boolean       @default(false)
  status      RoadmapStatus @default(idea)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues Issue[]

  dependencySource RoadmapDependency[] @relation("DependencySource")
  dependencyTarget RoadmapDependency[] @relation("DependencyTarget")

  @@index([projectId, horizon])
  @@map("roadmap_items")
}

model RoadmapDependency {
  id        String         @id @default(uuid()) @db.Uuid
  type      DependencyType @default(blocks)
  createdAt DateTime       @default(now()) @map("created_at")

  sourceId String      @map("source_id") @db.Uuid
  source   RoadmapItem @relation("DependencySource", fields: [sourceId], references: [id], onDelete: Cascade)

  targetId String      @map("target_id") @db.Uuid
  target   RoadmapItem @relation("DependencyTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
  @@map("roadmap_dependencies")
}

model WorkSession {
  id            String    @id @default(uuid()) @db.Uuid
  startedAt     DateTime  @default(now()) @map("started_at")
  lastHeartbeat DateTime  @default(now()) @map("last_heartbeat")
  source        String    @default("mcp") // "mcp" | "web" | "claude-code" | "cursor"

  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issueId  String @map("issue_id") @db.Uuid
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

  memberId String @map("member_id") @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([userId, issueId])
  @@index([issueId, lastHeartbeat])
  @@index([memberId, lastHeartbeat])
  @@map("work_sessions")
}

