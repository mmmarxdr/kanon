enum TriageProposalLifecycleState {
  disposed
  pending
  dismissed
  expired
}

model TriagePolicy {
  id                        String   @id @default(uuid()) @db.Uuid
  workspaceId               String   @map("workspace_id") @db.Uuid
  version                   String
  retentionDays             Int      @default(365) @map("retention_days")
  dispositionListVisibility String   @default("hidden") @map("disposition_list_visibility")
  createdAt                 DateTime @default(now()) @map("created_at")
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  proposals TriageProposal[]

  @@map("triage_policies")
}

model TriageProposal {
  id                String   @id @default(uuid()) @db.Uuid
  identityDigest    String   @unique @map("identity_digest") @db.VarChar(64)
  targetIssueId     String   @map("target_issue_id") @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  policyId          String   @map("policy_id") @db.Uuid
  
  lifecycle         TriageProposalLifecycleState @default(pending)
  listSummary       Json     @map("list_summary")
  
  createdAt         DateTime @default(now()) @map("created_at")
  expiresAt         DateTime @map("expires_at")
  disposedAt        DateTime? @map("disposed_at")

  /// Captured at creation from workspace policy — later policy edits must not shorten this.
  retentionEligibleAt     DateTime @map("retention_eligible_at")
  capturedRetentionDays   Int      @map("captured_retention_days")
  capturedPolicyVersion   String   @map("captured_policy_version")
  /// Captured from policy at disposition time (null until disposed).
  dispositionListVisible  Boolean? @map("disposition_list_visible")
  
  supersedesId      String?  @unique @map("supersedes_id") @db.Uuid
  
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policy            TriagePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  /// Self-links are blocked by SQL constraint `triage_proposals_supersedes_not_self`
  /// in migration `20260810150000_triage_supersession_unique`; Prisma cannot express it.
  supersedes        TriageProposal? @relation("TriageProposalSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  successor         TriageProposal? @relation("TriageProposalSupersession")
  
  content           TriageProposalContent?
  lifecycleEvents   TriageProposalLifecycleEvent[]

  @@index([targetIssueId])
  @@index([workspaceId, lifecycle])
  @@index([projectId, lifecycle])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([projectId, targetIssueId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@index([retentionEligibleAt])
  @@map("triage_proposals")
}

model TriageProposalContent {
  id                String   @id @default(uuid()) @db.Uuid
  proposalId        String   @unique @map("proposal_id") @db.Uuid
  payload           Json
  provenance        Json
  
  proposal          TriageProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  
  @@map("triage_proposal_contents")
}

model TriageProposalLifecycleEvent {
  id                String   @id @default(uuid()) @db.Uuid
  proposalId        String   @map("proposal_id") @db.Uuid
  state             TriageProposalLifecycleState
  reason            String?
  /// Bounded safe details (e.g. policy id/version on retention disposition).
  details           Json?
  actorId           String?  @map("actor_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  
  proposal          TriageProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  
  @@unique([proposalId, state])
  @@index([proposalId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("triage_proposal_lifecycle_events")
}
