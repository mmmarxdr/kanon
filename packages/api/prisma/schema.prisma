// Per-user credential: each member supplies their own provider API key, stored
// encrypted-at-rest (AES-256-GCM, see core/crypto.ts). externalUserId binds the
// Kanon member to the provider user (resolved via /my/account.json on connect).
model MemberIntegrationCredential {
  id             String   @id @default(uuid()) @db.Uuid
  encryptedKey   String   @map("encrypted_key")
  externalUserId String?  @map("external_user_id")
  externalLogin  String?  @map("external_login")
  lastValidatedAt DateTime?            @map("last_validated_at")
  lastAuthStatus  CredentialAuthStatus @default(unknown) @map("last_auth_status")
  revokedAt       DateTime?            @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberId     String                @map("member_id") @db.Uuid
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  connectionId String                @map("connection_id") @db.Uuid
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  works        IntegrationSyncWork[]

  @@unique([memberId, connectionId])
  @@index([connectionId])
  @@map("member_integration_credentials")
}

// Idempotency / link backbone: maps a Kanon entity (polymorphic by entityType)
// to its external object. entityId is NOT a formal FK because it spans
// issue/project/cycle tables.
model ExternalRef {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String   @map("entity_type") // "issue" | "project" | "cycle"
  // @db.Uuid: all referenceable Kanon entities (issue/project/cycle) use UUID PKs.
  entityId    String   @map("entity_id") @db.Uuid
  externalId  String   @map("external_id")
  externalUrl String?  @map("external_url")
  metadata    Json?
  bindingId   String   @map("binding_id") @db.Uuid
  binding     IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  works       IntegrationSyncWork[]
  applications IntegrationInboundApplication[]
  conflicts   IntegrationConflict[]
  acceptedReconciliationRecommendation IntegrationReconciliationRecommendation?
  remoteUpdatedAt DateTime? @map("remote_updated_at")
  localVersion BigInt @default(0) @map("local_version")
  lastCorrelationId String? @map("last_correlation_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  connectionId String                @map("connection_id") @db.Uuid
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entityType, entityId])
  // entityType is part of the external-id uniqueness: providers (e.g. Redmine)
  // use independent id sequences per type, so issue #42 and project #42 collide
  // on externalId alone.
  @@unique([connectionId, entityType, externalId])
  @@unique([bindingId, entityType, externalId])
  @@index([entityType, entityId])
  @@index([bindingId])
  @@map("external_refs")
}

model IntegrationReconciliationRecommendation {
  id                  String                                 @id @default(uuid()) @db.Uuid
  previewIdentity     String?                                @map("preview_identity") @db.Uuid
  remoteIssueId       String                                 @map("remote_issue_id")
  remoteSourceVersion String                                 @map("remote_source_version")
  score               Int
  scoringVersion      String                                 @map("scoring_version")
  /// Versioned numeric/boolean matching factors only; never provider issue content.
  factorEvidence      Json                                   @map("factor_evidence")
  localFingerprint    String                                 @map("local_fingerprint")
  remoteFingerprint   String                                 @map("remote_fingerprint")
  decisionState       IntegrationReconciliationDecisionState @default(pending) @map("decision_state")
  decisionKind        String?                                @map("decision_kind")
  decidedAt           DateTime?                              @map("decided_at")
  createdAt           DateTime                               @default(now()) @map("created_at")
  updatedAt           DateTime                               @updatedAt @map("updated_at")

  bindingId       String                    @map("binding_id") @db.Uuid
  binding         IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict, map: "integration_reconciliation_binding_fkey")
  candidateIssueId String                    @map("candidate_issue_id") @db.Uuid
  candidateIssue   Issue                     @relation(fields: [candidateIssueId], references: [id], onDelete: Restrict, map: "integration_reconciliation_candidate_fkey")
  decidedById      String?                   @map("decided_by_id") @db.Uuid
  decidedBy        Member?                   @relation(fields: [decidedById], references: [id], onDelete: SetNull, map: "integration_reconciliation_decider_fkey")
  acceptedRefId    String?                   @unique @map("accepted_ref_id") @db.Uuid
  acceptedRef      ExternalRef?              @relation(fields: [acceptedRefId], references: [id], onDelete: SetNull, map: "integration_reconciliation_accepted_ref_fkey")

  @@unique([bindingId, previewIdentity, remoteIssueId, remoteSourceVersion, candidateIssueId, scoringVersion, localFingerprint, remoteFingerprint], map: "uq_reconciliation_candidate_snapshot")
  // Accepted remote/local identity is one-to-one via partial unique indexes in the migration.
  @@index([bindingId, decisionState, score(sort: Desc), id(sort: Desc)], map: "integration_reconciliation_binding_state_score_id_idx")
  @@index([bindingId, remoteIssueId, score(sort: Desc), id(sort: Desc)], map: "integration_reconciliation_binding_remote_score_id_idx")
  @@index([bindingId, previewIdentity, remoteIssueId], map: "integration_reconciliation_preview_remote_idx")
  @@map("integration_reconciliation_recommendations")
}

model IntegrationReconciliationDisposition {
  id                  String                                    @id @default(uuid()) @db.Uuid
  previewIdentity     String                                    @map("preview_identity") @db.Uuid
  remoteIssueId       String                                    @map("remote_issue_id")
  remoteSourceVersion String                                    @map("remote_source_version")
  state               IntegrationReconciliationDispositionState @default(pending)
  decisionKind        String?                                   @map("decision_kind")
  decidedAt           DateTime?                                 @map("decided_at")
  decidedById         String?                                   @map("decided_by_id") @db.Uuid
  acceptedRefId       String?                                   @map("accepted_ref_id") @db.Uuid
  createdAt           DateTime                                  @default(now()) @map("created_at")
  updatedAt           DateTime                                  @updatedAt @map("updated_at")

  bindingId String                    @map("binding_id") @db.Uuid
  binding   IntegrationProjectBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict, map: "integration_reconciliation_disposition_binding_fkey")
  decidedBy Member?                   @relation(fields: [decidedById], references: [id], onDelete: SetNull, map: "integration_reconciliation_disposition_decider_fkey")

  @@unique([bindingId, previewIdentity, remoteIssueId], map: "uq_reconciliation_disposition_preview_remote")
  @@index([bindingId, previewIdentity, state], map: "integration_reconciliation_disposition_preview_state_idx")
  @@map("integration_reconciliation_dispositions")
}

model IntegrationSyncWork {
