{
  "name": "@kanon/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "seed:schedule-demo": "tsx prisma/scripts/seed-schedule-demo.ts",
    "db:studio": "prisma studio",
    "smoke-test": "bash scripts/smoke-test.sh",
    "test": "pnpm run test:types && vitest run",
    "test:types": "tsc --noEmit -p tsconfig.type-tests.json",
    "test:watch": "vitest",
    "test:unit": "vitest run src/modules/**/state-machine.test.ts src/modules/**/schema.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:db:setup": "DATABASE_URL=\"postgresql://kanon:kanon@localhost:5432/kanon_test?schema=public\" prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@kanon/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.0.0",
    "fastify-metrics": "^13.2.1",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3",
    "resend": "^6.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "pino-pretty": "^11.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
