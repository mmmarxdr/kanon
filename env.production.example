# env.production.example
# Copy to .env.production and fill in all CHANGE_ME values before starting the stack.
# NEVER commit .env.production — it contains real secrets.
#
# Generate secret values with: openssl rand -base64 48
# All secrets must be at least 32 characters in production.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Password must match POSTGRES_PASSWORD — the API and the database must agree.
DATABASE_URL=postgresql://kanon:CHANGE_ME@postgres:5432/kanon
POSTGRES_PASSWORD=CHANGE_ME

# ── Auth secrets (≥ 32 chars each) ───────────────────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME

# ── URLs ─────────────────────────────────────────────────────────────────────
# BASE_URL is embedded verbatim in every kanon:// onboarding link.
# Set it to the public API URL — a localhost value makes links unreachable from
# other machines.
BASE_URL=https://api.your-domain.com
APP_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

# ── Optional TTLs ─────────────────────────────────────────────────────────────
# SETUP_TOKEN_TTL_DAYS=7
# ONBOARDING_TOKEN_TTL_HOURS=72
